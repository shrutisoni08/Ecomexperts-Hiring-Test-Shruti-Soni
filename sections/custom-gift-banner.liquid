{%- style -%}
  #shopify-section-{{ section.id }} {
    --banner-bg: #ffffff;
    --bar-bg: #f5f5f5;
    --text-dark: #000000;
    --accent-yellow: #fff544;
    font-family: 'Jost', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  .cg-banner-wrapper {
    background-color: var(--banner-bg);
    color: var(--text-dark);
    width: 100%;
    overflow: hidden;
  }

  /* Top Announcement / Nav Bar */
  .cg-top-bar {
    background-color: var(--bar-bg);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 48px;
    border-bottom: 1px solid #ececec;
    gap: 16px;
  }

  .cg-brand-logo {
    font-size: 20px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0;
    color: var(--text-dark);
    text-decoration: none;
  }

  .cg-top-tagline {
    font-size: 15px;
    font-weight: 400;
    margin: 0;
    text-align: center;
  }

  /* Animated Slide Buttons */
  .cg-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    padding: 12px 26px;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    overflow: hidden;
    border: none;
    z-index: 1;
    transition: color 0.35s ease;
  }

  .cg-btn-yellow {
    background-color: var(--accent-yellow);
    color: #000000;
  }

  .cg-btn-yellow::before {
    content: '';
    position: absolute;
    inset: 0;
    background-color: #000000;
    transform: translateX(-101%);
    transition: transform 0.35s cubic-bezier(0.25, 1, 0.5, 1);
    z-index: -1;
  }

  .cg-btn-yellow:hover {
    color: #ffffff;
  }

  .cg-btn-yellow:hover::before {
    transform: translateX(0);
  }

  .cg-btn-black {
    background-color: #000000;
    color: #ffffff;
    padding: 15px 34px;
  }

  .cg-btn-black::before {
    content: '';
    position: absolute;
    inset: 0;
    background-color: var(--accent-yellow);
    transform: translateX(-101%);
    transition: transform 0.35s cubic-bezier(0.25, 1, 0.5, 1);
    z-index: -1;
  }

  .cg-btn-black:hover {
    color: #000000;
  }

  .cg-btn-black:hover::before {
    transform: translateX(0);
  }

  .cg-btn-arrow {
    display: inline-block;
    transition: transform 0.3s ease;
  }

  .cg-btn:hover .cg-btn-arrow {
    transform: translateX(5px);
  }

  /* Main Hero Body */
  .cg-hero-main {
    position: relative;
    min-height: 620px;
    display: flex;
    align-items: flex-end;
    padding: 60px 48px;
    background-size: cover;
    background-position: right center;
    background-repeat: no-repeat;
  }

  .cg-hero-content {
    position: relative;
    z-index: 2;
    max-width: 520px;
    background: rgba(255, 255, 255, 0.94);
    padding: 24px 28px 24px 0;
  }

  .cg-hero-title {
    font-size: clamp(40px, 5vw, 68px);
    font-weight: 500;
    line-height: 1.05;
    margin: 0 0 22px 0;
    letter-spacing: -0.02em;
    color: var(--text-dark);
  }

  .cg-hero-desc {
    font-size: 18px;
    line-height: 1.5;
    margin: 0 0 32px 0;
    color: #1a1a1a;
  }

  .cg-mobile-illustration {
    display: none;
    width: 100%;
    height: auto;
    object-fit: cover;
  }

  /* Bottom Announcement Strip */
  .cg-bottom-bar {
    background-color: var(--bar-bg);
    text-align: center;
    padding: 12px 20px;
    font-size: 13px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    border-top: 1px solid #ececec;
  }

  /* Mobile Responsiveness */
  @media screen and (max-width: 768px) {
    .cg-top-bar {
      padding: 14px 20px;
      flex-wrap: wrap;
      justify-content: center;
    }
    .cg-top-tagline {
      display: none;
    }
    .cg-hero-main {
      min-height: auto;
      padding: 32px 20px 0 20px;
      background-image: none !important;
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
    .cg-hero-content {
      padding: 0 0 28px 0;
      max-width: 100%;
    }
    .cg-hero-desc {
      font-size: 16px;
    }
    .cg-mobile-illustration {
      display: block;
      max-height: 300px;
      object-position: top;
    }
    .cg-bottom-bar {
      font-size: 11px;
      padding: 10px 14px;
    }
  }
{%- endstyle -%}

<section class="cg-banner-wrapper" data-section-id="{{ section.id }}">
  <!-- Top Bar -->
  <div class="cg-top-bar">
    <a href="{{ routes.root_url }}" class="cg-brand-logo">{{ section.settings.brand_title }}</a>
    <p class="cg-top-tagline">{{ section.settings.top_tagline }}</p>
    {%- if section.settings.top_btn_text != blank -%}
      <a href="{{ section.settings.top_btn_link | default: '#gift-grid' }}" class="cg-btn cg-btn-yellow js-smooth-scroll">
        <span>{{ section.settings.top_btn_text }}</span>
        <span class="cg-btn-arrow">&rarr;</span>
      </a>
    {%- endif -%}
  </div>

  <!-- Main Banner -->
  <div
    class="cg-hero-main"
    {% if section.settings.bg_image != blank %}
      style="background-image: url('{{ section.settings.bg_image | image_url: width: 2000 }}');"
    {% endif %}
  >
    <div class="cg-hero-content">
      <h1 class="cg-hero-title">{{ section.settings.heading }}</h1>
      <p class="cg-hero-desc">{{ section.settings.description }}</p>
      {%- if section.settings.cta_text != blank -%}
        <a href="{{ section.settings.cta_link | default: '#gift-grid' }}" class="cg-btn cg-btn-black js-smooth-scroll">
          <span>{{ section.settings.cta_text }}</span>
          <span class="cg-btn-arrow">&rarr;</span>
        </a>
      {%- endif -%}
    </div>

    {% if section.settings.bg_image != blank %}
      <img
        src="{{ section.settings.bg_image | image_url: width: 900 }}"
        alt="{{ section.settings.heading | escape }}"
        class="cg-mobile-illustration"
        loading="lazy"
        width="900"
        height="450"
      >
    {% endif %}
  </div>

  <!-- Bottom Strip -->
  <div class="cg-bottom-bar">
    {{ section.settings.bottom_text }}
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const sectionEl = document.querySelector('[data-section-id="{{ section.id }}"]');
    if (!sectionEl) return;

    sectionEl.querySelectorAll('.js-smooth-scroll').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const href = btn.getAttribute('href');
        if (href && href.startsWith('#') && href.length > 1) {
          const target = document.querySelector(href);
          if (target) {
            e.preventDefault();
            target.scrollIntoView({ behavior: 'smooth' });
          }
        }
      });
    });
  });
</script>

{% schema %}
{
  "name": "Custom Gift Banner",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "brand_title",
      "label": "Top Left Brand Title",
      "default": "TISSO VISON"
    },
    {
      "type": "text",
      "id": "top_tagline",
      "label": "Top Center Tagline",
      "default": "Find the ideal gift for your loved ones."
    },
    {
      "type": "text",
      "id": "top_btn_text",
      "label": "Top Right Button Text",
      "default": "CHOOSE GIFT"
    },
    {
      "type": "url",
      "id": "top_btn_link",
      "label": "Top Right Button Link"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Banner Line-Art Illustration"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "The Gift Guide"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description Text",
      "default": "Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Main CTA Button Text",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Main CTA Button Link"
    },
    {
      "type": "text",
      "id": "bottom_text",
      "label": "Bottom Strip Text",
      "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL"
    }
  ],
  "presets": [
    {
      "name": "Custom Gift Banner"
    }
  ]
}
{% endschema %}